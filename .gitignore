# Artefactos de compilación (en build/ solo se versionan los assets de los samples)
/build/*
!/build/samples/
/build/samples/*
!/build/samples/*/
/build/samples/*/*
!/build/samples/*/images/
!/build/samples/*/roms/
/build-debug/

# Restos de ejecutar "cmake ." en la raíz (CMake lo rechaza, pero deja estos ficheros)
CMakeCache.txt
CMakeFiles/

# Presets personales de CMake y caché de clangd (usa compile_commands.json)
CMakeUserPresets.json
.cache/

# Editores y temporales
*.log
*~
.*.un~

# ROMs comerciales: no se versionan
*.sms
*.gg
*.sg
*.zip
*.rom
*.tap

# Partidas guardadas (RAM del cartucho) que genera el emulador junto a cada ROM
*.sav
*.sav.tmp

# Estados guardados (F2) junto a cada juego: juego.tap.state, juego.tap.state1...
*.state
*.state[0-9]*
