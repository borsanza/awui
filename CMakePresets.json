{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build"
		},
		{
			"name": "release",
			"displayName": "Release",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-debug",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "sanitize",
			"displayName": "Sanitizers (ASan + UBSan)",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-sanitize",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "AWUI_SANITIZE": "ON" }
		},
		{
			"name": "package",
			"displayName": "Paquete .deb de StationTV (instalado en /usr; luego cpack en build-package)",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-package",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_INSTALL_PREFIX": "/usr" }
		},
		{
			"name": "windows",
			"displayName": "Windows (MinGW-w64, desde Linux: scripts/build-windows.sh)",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-windows",
			"toolchainFile": "${sourceDir}/cmake/mingw64.cmake",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		}
	],
	"buildPresets": [
		{ "name": "release", "configurePreset": "release" },
		{ "name": "debug", "configurePreset": "debug" },
		{ "name": "sanitize", "configurePreset": "sanitize" },
		{ "name": "package", "configurePreset": "package" },
		{ "name": "windows", "configurePreset": "windows" }
	]
}
