{
	"version": "0.2.0",
	"configurations": [
		{
			// Compila en Debug (build-debug/) y lo lanza con gdb: permite puntos de ruptura
			"name": "Depurar (Debug)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build-debug/samples/${input:sample}/${input:sample}",
			// Los samples cargan images/ y roms/ con rutas relativas: se ejecutan desde build/samples/<sample>
			"cwd": "${workspaceFolder}/build/samples/${input:sample}",
			"MIMode": "gdb",
			"preLaunchTask": "Compilar (Debug)",
			"setupCommands": [
				{ "description": "Pretty printing de gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
			],
			"windows": {
				"program": "${workspaceFolder}/build-debug/samples/${input:sample}/${input:sample}.exe",
				"miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
			}
		},
		{
			// Compila en Release (build/) y lo lanza: la velocidad real del emulador
			"name": "Ejecutar (Release)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/samples/${input:sample}/${input:sample}",
			"cwd": "${workspaceFolder}/build/samples/${input:sample}",
			"MIMode": "gdb",
			"preLaunchTask": "Compilar (Release)",
			"windows": {
				"program": "${workspaceFolder}/build/samples/${input:sample}/${input:sample}.exe",
				"miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
			}
		}
	],
	"inputs": [
		{
			"id": "sample",
			"type": "pickString",
			"description": "¿Qué programa quieres lanzar?",
			"options": ["stationTV", "gameOfBlocks", "awuiDemo", "awSlider", "awTest"],
			"default": "stationTV"
		}
	]
}
